{
  "name": "markdown-browser",
  "version": "0.2.0",
  "author": "nampluskr",
  "private": true,
  "description": "A lightweight Windows desktop browser for local Markdown documents.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.nampluskr.markdownbrowser",
    "productName": "Markdown Browser",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": { "target": ["nsis"], "icon": "resources/markdown-browser.svg" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-v0.2-Setup.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "MarkdownDocument",
        "description": "Markdown Document",
        "role": "Viewer"
      }
    ]
  }
}
